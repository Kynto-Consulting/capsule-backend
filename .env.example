CAPSULE_ENV=development
CAPSULE_PORT=8080
CAPSULE_LOG_LEVEL=debug
CAPSULE_SECRET_KEY=replace-me-with-a-strong-secret

DATABASE_URL=postgresql://capsule:capsule_dev@localhost:5432/capsule?sslmode=disable
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REGISTRY=
ARTIFACTS_BUCKET=capsule-artifacts-598806201852

# ── Deploy robustness (all optional; empty = default) ───────────────────────
# Container must stay up this many seconds before traffic switches when the project has no health_path (default 5)
CAPSULE_DEPLOY_MIN_UPTIME_SECONDS=
# Build limits. Enforced per RUN step ONLY for Dockerfiles that do not need BuildKit syntax (legacy builder);
# BuildKit-only Dockerfiles get just the timeout + concurrency gate (a warning is written to the build log).
# Suggested for the 4 GB host: 1500m. SWAP defaults to the same value (= no swap for the build).
CAPSULE_BUILD_MEMORY=
CAPSULE_BUILD_MEMORY_SWAP=
CAPSULE_BUILD_CPUS=
# Wall-clock limit of one docker build (default 30) and builds running at once (default 1)
CAPSULE_BUILD_TIMEOUT_MINUTES=
CAPSULE_BUILD_MAX_CONCURRENT=
# Optional buildx builder (docker-container driver created with --driver-opt memory=...) used for ALL builds
CAPSULE_BUILD_BUILDER=
# Scheduled cleanup of build cache + orphan images (never touches images in use or the last successful deployment's)
CAPSULE_CLEANUP_INTERVAL_HOURS=
CAPSULE_CLEANUP_CACHE_MAX_AGE_HOURS=
CAPSULE_CLEANUP_KEEP_STORAGE=
# Filesystem checked for the 80% disk alert; above CAPSULE_DISK_MAX_PERCENT (default 85) the cache is cut hard
CAPSULE_DISK_PATH=
CAPSULE_DISK_MAX_PERCENT=
